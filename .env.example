# ─── Database ─────────────────────────────────────────────────────────────────
# Get this from Neon (neon.tech), Supabase, or your local PostgreSQL
DATABASE_URL="postgresql://user:password@host:5432/restaurant"

# ─── Auth.js ──────────────────────────────────────────────────────────────────
# Generate a secret: run this in your terminal:
#   openssl rand -base64 32
AUTH_SECRET="replace-with-32-char-random-secret"
NEXTAUTH_URL="http://localhost:3000"

# ─── Vercel Blob (optional — for image uploads) ───────────────────────────────
# Get this from Vercel dashboard → Storage → Blob → create a store
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_..."
